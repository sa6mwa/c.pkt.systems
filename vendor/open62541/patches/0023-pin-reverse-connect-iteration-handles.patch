+/* Select by stable handles rather than retaining a list link across user
+ * logging/connection callbacks. Those callbacks may remove other entries. */
+static reverse_connect_context *
+nextReverseConnect(UA_BinaryProtocolManager *bpm, UA_UInt64 after,
+                   UA_UInt64 maximum) {
+    reverse_connect_context *candidate = NULL, *rc;
+    LIST_FOREACH(rc, &bpm->reverseConnects, next) {
+        if(rc->handle <= after || rc->handle > maximum || rc->destruction)
+            continue;
+        if(!candidate || rc->handle < candidate->handle)
+            candidate = rc;
+    }
+    return candidate;
+}
