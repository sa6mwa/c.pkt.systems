+/* Route one OpenSSL error-queue entry at a time through the policy logger. */
+struct KeyDerivationLogContext {
+    const UA_Logger *logger;
+    UA_Boolean emitted;
+};
+
+static int
+logKeyDerivationError(const char *message, size_t length, void *context) {
+    struct KeyDerivationLogContext *ctx = (struct KeyDerivationLogContext*)context;
+    UA_String text = {length, (UA_Byte*)(uintptr_t)message};
+    UA_LOG_ERROR(ctx->logger, UA_LOGCATEGORY_SECURITYPOLICY,
+                 "OpenSSL key derivation failed: %S", text);
+    ctx->emitted = true;
+    return 1;
+}
+
+void
+UA_OpenSSL_LogKeyDerivationErrors(const UA_Logger *logger) {
+    struct KeyDerivationLogContext ctx = {logger, false};
+    ERR_print_errors_cb(logKeyDerivationError, &ctx);
+    if(!ctx.emitted)
+        UA_LOG_ERROR(logger, UA_LOGCATEGORY_SECURITYPOLICY,
+                     "OpenSSL key derivation failed");
+}
+
