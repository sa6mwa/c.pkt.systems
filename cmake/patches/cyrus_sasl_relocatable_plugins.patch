+#if defined(PIC) && !defined(WIN32)
+/* Locate shipped mechanisms beside the shared library, not in /usr/lib. */
+static int
+_sasl_get_bundled_plugin_path(char **path_dest)
+{
+    Dl_info library;
+    const char *slash;
+    size_t directory_length;
+    char *path;
+
+    if (dladdr((const void *)&_sasl_getpath, &library) == 0 ||
+        library.dli_fname == NULL)
+        return SASL_FAIL;
+    slash = strrchr(library.dli_fname, '/');
+    if (slash == NULL)
+        return SASL_FAIL;
+    directory_length = (size_t)(slash - library.dli_fname);
+    if (directory_length > (size_t)-1 - sizeof("/sasl2"))
+        return SASL_FAIL;
+    path = sasl_ALLOC(directory_length + sizeof("/sasl2"));
+    if (path == NULL)
+        return SASL_NOMEM;
+    memcpy(path, library.dli_fname, directory_length);
+    memcpy(path + directory_length, "/sasl2", sizeof("/sasl2"));
+    *path_dest = path;
+    return SASL_OK;
+}
+#endif
