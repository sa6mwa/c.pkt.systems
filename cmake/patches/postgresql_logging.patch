+/* The process default is consulted during option parsing and later operations,
+ * so passfile warnings are observable even during PQconnectStart. */
+void
+PQsetDefaultDiagnosticProcessor(PQdiagnosticProcessor proc, void *arg)
+{
+	default_diagnostic_proc = proc;
+	default_diagnostic_arg = arg;
+}
+
+void
+PQsetDiagnosticProcessor(PGconn *conn, PQdiagnosticProcessor proc, void *arg)
+{
+	if (conn == NULL)
+		return;
+	conn->diagnosticProc = proc;
+	conn->diagnosticArg = arg;
+}
+
+void
+pqEmitDiagnostic(PGconn *conn, int level, const char *fmt,...)
+{
+	int saved_errno = errno;
+	PQExpBufferData buf;
+	va_list ap;
+	bool done;
+
+	initPQExpBuffer(&buf);
+	if (!PQExpBufferBroken(&buf))
+	{
+		do
+		{
+			errno = saved_errno;
+			va_start(ap, fmt);
+			done = appendPQExpBufferVA(&buf, fmt, ap);
+			va_end(ap);
+		} while (!done);
+		if (!PQExpBufferBroken(&buf))
+		{
+			PQdiagnosticProcessor proc = conn != NULL && conn->diagnosticProc != NULL ?
+				conn->diagnosticProc : default_diagnostic_proc;
+			void *arg = conn != NULL && conn->diagnosticProc != NULL ?
+				conn->diagnosticArg : default_diagnostic_arg;
+			if (proc != NULL)
+				proc(arg, conn, level, buf.data);
+			else
+				fputs(buf.data, stderr);
+		}
+	}
+	termPQExpBuffer(&buf);
+	errno = saved_errno;
+}
