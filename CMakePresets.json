{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CPKT_BUILD_DEPENDENCIES": "ON",
        "CPKT_BUILD_TESTS": "ON",
        "CPKT_DIST_DIR": "${sourceDir}/dist"
      }
    },
    {
      "name": "x86_64-linux-gnu-release",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-linux-gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CPKT_TARGET_ARCH": "x86_64",
        "CPKT_TARGET_OS": "linux",
        "CPKT_TARGET_LIBC": "gnu"
      }
    },
    {
      "name": "release",
      "inherits": "x86_64-linux-gnu-release"
    },
    {
      "name": "debug",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-linux-gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPKT_TARGET_ARCH": "x86_64",
        "CPKT_TARGET_OS": "linux",
        "CPKT_TARGET_LIBC": "gnu"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/llvm-linux.cmake",
      "cacheVariables": {
        "CPKT_BUILD_DEPENDENCIES": "OFF",
        "CPKT_FACADE_ONLY": "ON",
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/llvm-linux.cmake",
      "cacheVariables": {
        "CPKT_BUILD_DEPENDENCIES": "OFF",
        "CPKT_FACADE_ONLY": "ON",
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fno-omit-frame-pointer -fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "-fsanitize=thread"
      }
    },
    {
      "name": "msan",
      "inherits": "debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/llvm-linux.cmake",
      "cacheVariables": {
        "CPKT_BUILD_DEPENDENCIES": "OFF",
        "CPKT_FACADE_ONLY": "ON",
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fno-omit-frame-pointer -fsanitize=memory -fsanitize-memory-track-origins=2",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=memory -fsanitize-memory-track-origins=2",
        "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "-fsanitize=memory -fsanitize-memory-track-origins=2"
      }
    },
    {
      "name": "fuzz",
      "inherits": "debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/llvm-linux.cmake",
      "cacheVariables": {
        "CPKT_BUILD_DEPENDENCIES": "OFF",
        "CPKT_FACADE_ONLY": "ON",
        "CPKT_ENABLE_FUZZING": "ON"
      }
    },
    {
      "name": "opcua-fuzz",
      "inherits": "debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/llvm-linux.cmake",
      "cacheVariables": {
        "CPKT_ALLOW_DEPENDENCY_ROOT_OVERRIDE": "ON",
        "CPKT_BUILD_DEPENDENCIES": "OFF",
        "CPKT_FACADE_ONLY": "OFF",
        "CPKT_ENABLE_FUZZING": "ON"
      }
    },
    {
      "name": "x86_64-linux-musl-release",
      "inherits": "x86_64-linux-gnu-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-linux-musl.cmake",
      "cacheVariables": {
        "CPKT_TARGET_ARCH": "x86_64",
        "CPKT_TARGET_OS": "linux",
        "CPKT_TARGET_LIBC": "musl"
      }
    },
    {
      "name": "aarch64-linux-gnu-release",
      "inherits": "x86_64-linux-gnu-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake",
      "cacheVariables": {
        "CPKT_TARGET_ARCH": "aarch64",
        "CPKT_TARGET_OS": "linux",
        "CPKT_TARGET_LIBC": "gnu"
      }
    },
    {
      "name": "aarch64-linux-musl-release",
      "inherits": "x86_64-linux-gnu-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-musl.cmake",
      "cacheVariables": {
        "CPKT_TARGET_ARCH": "aarch64",
        "CPKT_TARGET_OS": "linux",
        "CPKT_TARGET_LIBC": "musl"
      }
    },
    {
      "name": "armhf-linux-gnu-release",
      "inherits": "x86_64-linux-gnu-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/armhf-linux-gnu.cmake",
      "cacheVariables": {
        "CPKT_TARGET_ARCH": "armhf",
        "CPKT_TARGET_OS": "linux",
        "CPKT_TARGET_LIBC": "gnu"
      }
    },
    {
      "name": "armhf-linux-musl-release",
      "inherits": "x86_64-linux-gnu-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/armhf-linux-musl.cmake",
      "cacheVariables": {
        "CPKT_TARGET_ARCH": "armhf",
        "CPKT_TARGET_OS": "linux",
        "CPKT_TARGET_LIBC": "musl"
      }
    },
    {
      "name": "arm64-apple-darwin-release",
      "inherits": "x86_64-linux-gnu-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm64-apple-darwin.cmake",
      "cacheVariables": {
        "CPKT_TARGET_ARCH": "arm64",
        "CPKT_TARGET_OS": "darwin",
        "CPKT_TARGET_LIBC": ""
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x86_64-linux-gnu-release",
      "configurePreset": "x86_64-linux-gnu-release"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "msan",
      "configurePreset": "msan"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "opcua-fuzz",
      "configurePreset": "opcua-fuzz"
    },
    {
      "name": "x86_64-linux-musl-release",
      "configurePreset": "x86_64-linux-musl-release"
    },
    {
      "name": "aarch64-linux-gnu-release",
      "configurePreset": "aarch64-linux-gnu-release"
    },
    {
      "name": "aarch64-linux-musl-release",
      "configurePreset": "aarch64-linux-musl-release"
    },
    {
      "name": "armhf-linux-gnu-release",
      "configurePreset": "armhf-linux-gnu-release"
    },
    {
      "name": "armhf-linux-musl-release",
      "configurePreset": "armhf-linux-musl-release"
    },
    {
      "name": "arm64-apple-darwin-release",
      "configurePreset": "arm64-apple-darwin-release"
    },
    {
      "name": "package-x86_64-linux-gnu-release",
      "configurePreset": "x86_64-linux-gnu-release",
      "targets": [
        "package-bundle"
      ]
    },
    {
      "name": "package-x86_64-linux-musl-release",
      "configurePreset": "x86_64-linux-musl-release",
      "targets": [
        "package-bundle"
      ]
    },
    {
      "name": "package-aarch64-linux-gnu-release",
      "configurePreset": "aarch64-linux-gnu-release",
      "targets": [
        "package-bundle"
      ]
    },
    {
      "name": "package-aarch64-linux-musl-release",
      "configurePreset": "aarch64-linux-musl-release",
      "targets": [
        "package-bundle"
      ]
    },
    {
      "name": "package-armhf-linux-gnu-release",
      "configurePreset": "armhf-linux-gnu-release",
      "targets": [
        "package-bundle"
      ]
    },
    {
      "name": "package-armhf-linux-musl-release",
      "configurePreset": "armhf-linux-musl-release",
      "targets": [
        "package-bundle"
      ]
    },
    {
      "name": "package-arm64-apple-darwin-release",
      "configurePreset": "arm64-apple-darwin-release",
      "targets": [
        "package-bundle",
        "package-darwin-smoke-test"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "x86_64-linux-gnu-release",
      "configurePreset": "x86_64-linux-gnu-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msan",
      "configurePreset": "msan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x86_64-linux-musl-release",
      "configurePreset": "x86_64-linux-musl-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "aarch64-linux-gnu-release",
      "configurePreset": "aarch64-linux-gnu-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "aarch64-linux-musl-release",
      "configurePreset": "aarch64-linux-musl-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "armhf-linux-gnu-release",
      "configurePreset": "armhf-linux-gnu-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "armhf-linux-musl-release",
      "configurePreset": "armhf-linux-musl-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
