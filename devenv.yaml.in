apiVersion: v1
kind: Pod
metadata:
  name: CPKT_POSTGRES_POD
spec:
  restartPolicy: Never
  containers:
    - name: postgres
      image: docker.io/library/postgres:14.24-alpine3.24
      securityContext:
        runAsUser: 70
        runAsGroup: 70
      env:
        - name: POSTGRES_HOST_AUTH_METHOD
          value: trust
        - name: PGDATA
          value: /var/lib/postgresql/data/pgdata
      ports:
        - containerPort: 5432
          hostPort: CPKT_POSTGRES_PORT
          hostIP: 127.0.0.1
      volumeMounts:
        - name: postgres-state
          mountPath: /var/lib/postgresql/data
  volumes:
    - name: postgres-state
      hostPath:
        path: CPKT_POSTGRES_STATE
        type: Directory
---
apiVersion: v1
kind: Pod
metadata:
  name: CPKT_COCKROACH_POD
spec:
  restartPolicy: Never
  containers:
    - name: cockroach
      image: docker.io/cockroachdb/cockroach:v26.2.6
      command:
        - /cockroach/cockroach
      securityContext:
        runAsUser: 70
        runAsGroup: 70
      args:
        - start-single-node
        - --insecure
        - --listen-addr=0.0.0.0:26257
        - --http-addr=127.0.0.1:8080
        - --store=/cockroach/cockroach-data
        - --cache=64MiB
        - --max-sql-memory=64MiB
      ports:
        - containerPort: 26257
          hostPort: CPKT_COCKROACH_PORT
          hostIP: 127.0.0.1
      volumeMounts:
        - name: cockroach-state
          mountPath: /cockroach/cockroach-data
  volumes:
    - name: cockroach-state
      hostPath:
        path: CPKT_COCKROACH_STATE
        type: Directory
